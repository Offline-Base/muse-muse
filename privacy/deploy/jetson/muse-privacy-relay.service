# Dials out to the connector relay and forwards Muse's requests to the local connector.
# Enable it after RELAY_URL is set in /etc/muse-privacy/env and the device is paired.
[Unit]
Description=Muse Privacy relay client (dials out to the connector relay)
Wants=network-online.target muse-privacy.service
After=network-online.target muse-privacy.service

[Service]
Type=simple
User=muse-privacy
Group=muse-privacy
WorkingDirectory=/opt/muse-privacy/app
Environment=BASE_DEVICE=jetson
Environment=GLIMMER_BACKEND=llama_server
Environment=BASE_HOME=/var/lib/muse-privacy/home
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/muse-privacy/env
ExecStart=/opt/muse-privacy/app/.venv/bin/python -m base.connector.relay_client run
Restart=on-failure
RestartSec=10
# Exit 3: the relay rejected the device secret, or another copy took over. Retrying would only
# hammer the relay (or knock the other copy off in turn), so systemd does not restart it.
RestartPreventExitStatus=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# This is the one process that parses frames from the internet, so it sees only the two files it
# needs, read-only: an empty tmpfs over the state folder, with relay.json and connector_token
# bound in. The tag map, base.db, the output folder, adapters and the workspace do not exist
# here. Run "register" and "pair" by hand (sudo -u muse-privacy), not through this unit.
ReadWritePaths=/var/lib/muse-privacy
TemporaryFileSystem=/var/lib/muse-privacy:ro
BindReadOnlyPaths=/var/lib/muse-privacy/home/relay.json /var/lib/muse-privacy/home/connector_token
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
