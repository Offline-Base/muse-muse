+                // Muse patch: the columns are split across threads. Each column still adds its rows in the same
+                // order with the same expressions, so the sums match the single-threaded loop bit for bit.
+                {
+                    const int64_t nrows = src1->ne[1];
+                    const size_t nb1 = src1->nb[1];
+                    const char * base = data + i2 * src1->nb[2] + i3 * src1->nb[3];
+                    auto work = [&](int64_t j0, int64_t j1) {
+                        for (int64_t row = 0; row < nrows; ++row) {
+                            const float * x = (const float *) (base + row * nb1);
+                            for (int64_t j = j0; j < j1; ++j) { acc[j] += x[j] * x[j]; }
+                            if (act) {
+                                for (int64_t j = j0; j < j1; ++j) { act[j] += x[j]; }
+                            }
