{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:musemuse:manifest",
  "title": "Muse Muse product manifest",
  "description": "Filled in by Muse Code during a build. The platform uses it for the product page, the gateway allowlist and the Muse app connector.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "tagline", "inspiration", "models", "actions", "fixtures", "limits", "estimatedCostPerRunUsd"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
    "tagline": { "type": "string", "minLength": 1, "maxLength": 120 },
    "inspiration": { "type": "string", "minLength": 1, "description": "One line on what the user gave and asked for" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "usedFor"],
        "properties": {
          "id": {
            "enum": ["muse-wonder-1.0", "muse-image-1.0", "sam-3.1", "muse-voice-transcribe-1.0", "muse-glimmer", "muse-gadget"]
          },
          "usedFor": { "type": "string", "minLength": 1 }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Each action is served at POST /api/actions/<name> and becomes a Muse app connector tool.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "input", "output"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string", "minLength": 1 },
          "input": { "type": "object", "description": "JSON Schema for the request body" },
          "output": { "type": "object", "description": "JSON Schema for the response body" },
          "example": { "type": "object", "description": "Example request body used by tests" },
          "who": {
            "enum": ["anyone", "owner"],
            "description": "Who may run it. An owner action stays off the Muse app connector, whose callers are anonymous. Default anyone."
          },
          "annotations": {
            "type": "object",
            "additionalProperties": false,
            "description": "What the connector tells other apps about this action.",
            "properties": {
              "readOnly": { "type": "boolean", "description": "It only reads, and changes nothing" },
              "openWorld": { "type": "boolean", "description": "It reaches the web or other outside services" }
            }
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description"],
        "properties": {
          "path": { "type": "string", "pattern": "^fixtures/" },
          "description": { "type": "string" }
        }
      }
    },
    "limits": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "estimatedCostPerRunUsd": { "type": "number", "minimum": 0 },
    "caps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["data", "files", "connect", "jobs", "live", "media", "code", "runtime", "hardware", "extension", "games"] },
      "description": "Only for a product with platform services: the ones it uses. It can narrow what the brief picked, never widen it."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collections"],
      "description": "Only for a product that saves data through the platform: exactly the brief's collections, which verify checks.",
      "properties": {
        "collections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "scope"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
              "scope": { "enum": ["shared", "visitor", "owner", "user"] },
              "writes": { "enum": ["owner", "signed_in", "anyone"], "description": "Shared collections only. Default owner." }
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "description": "Only for a product that keeps files through the platform: exactly the brief's files choices, which verify checks.",
      "properties": {
        "scope": { "enum": ["shared", "visitor", "owner", "user"] },
        "uploads": { "enum": ["owner", "signed_in", "anyone"], "description": "Shared files only: who adds them. Default owner." },
        "search": { "type": "boolean" },
        "datasets": { "type": "array", "maxItems": 3, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,47}$" } }
      }
    },
    "connect": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only for a product that reaches outside services through the platform: exactly the brief's picks, which verify checks.",
      "properties": {
        "publicApis": { "type": "array", "maxItems": 4, "items": { "enum": ["nws", "wikipedia", "openlibrary", "usgs"] } },
        "keys": { "type": "array", "maxItems": 3, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" } },
        "sends": { "type": "array", "maxItems": 2, "items": { "enum": ["email", "chat"] } }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "tools", "connections"],
      "description": "Only when the product is an agent. Its tools can narrow what the brief picked, never widen it.",
      "properties": {
        "task": { "type": "string", "minLength": 1, "description": "One line on what the agent does" },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "usedFor"],
            "properties": {
              "id": {
                "enum": ["web_search", "scholar", "places", "events", "read_page", "gmail_read", "gmail_draft", "gmail_send", "calendar_read", "calendar_add", "slack_read", "slack_search", "slack_send"]
              },
              "usedFor": { "type": "string", "minLength": 1 }
            }
          }
        },
        "connections": { "enum": ["none", "owner"], "description": "owner when a tool works on the owner's own account" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxTurns": { "type": "integer", "minimum": 1 },
            "maxToolCalls": { "type": "integer", "minimum": 0 },
            "maxCostUsd": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
