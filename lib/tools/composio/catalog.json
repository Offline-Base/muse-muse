            "openWorldHint",
            "readOnlyHint"
          ],
          "instant": true,
          "name": "SERPAPI_SCHOLAR_SEARCH",
          "parameters": {
            "additionalProperties": false,
            "properties": {
              "num": {
                "description": "Maximum number of results to return per page. Default is 10, maximum is 20.",
                "type": "integer"
              },
              "query": {
                "description": "The search query for Google Scholar. This can be an academic topic, paper title, author name, or specific keywords.",
                "type": "string"
              },
              "start": {
                "description": "Result offset for pagination. Use 0 for the first page (default), 10 for the second page, 20 for the third, etc.",
