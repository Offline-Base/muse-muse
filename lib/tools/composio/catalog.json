                  "link": "https://example.com/papers/sample-paper",
                  "position": 1,
                  "publication_info": {
                    "summary": "A Author, B Author - Example Journal, 2026"
                  },
                  "snippet": "A short sample passage from the paper, standing in for a live result.",
                  "title": "A sample paper on your topic"
