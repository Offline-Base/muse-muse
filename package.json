{
  "name": "muse-muse",
  "version": "0.0.1",
  "private": true,
  "description": "Give it an example or inspo and Muse makes it: a working product built by Muse Code on Meta's models.",
  "type": "module",
  "scripts": {
    "dev": "next dev -H localhost",
    "dev:local": "tsx --env-file-if-exists=.env.local scripts/dev-local.ts",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "snapshot": "tsx --env-file-if-exists=.env.local scripts/make-builder-snapshot.ts",
    "rebuild-all": "tsx --env-file-if-exists=.env.local scripts/rebuild-all.ts",
    "knowledge:corpus": "tsx scripts/knowledge/build-corpus.ts --articles 3000",
    "knowledge:dataset": "tsx --env-file-if-exists=.env.local scripts/knowledge/make-dataset.ts",
    "knowledge:status": "tsx scripts/knowledge/control.ts status",
    "knowledge:pause": "tsx scripts/knowledge/control.ts pause",
    "knowledge:resume": "tsx scripts/knowledge/control.ts resume",
    "docs:sync": "tsx scripts/docs/sync-meta-docs.ts",
    "tools:sync": "tsx --env-file-if-exists=.env.local scripts/tools/sync-composio-catalog.ts"
  },
  "dependencies": {
    "@composio/core": "0.27.0",
    "@meta-sam/parser": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "@vercel/sandbox": "3.9.0",
    "@vercel/sdk": "1.28.51",
    "drizzle-orm": "0.45.4",
    "marked": "18.1.2",
    "next": "16.4.3",
    "openai": "7.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "workflow": "5.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
