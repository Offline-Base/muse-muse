{
  "name": "muse-muse",
  "version": "0.0.1",
  "private": true,
  "description": "Give it an example or inspo and Muse makes it: a working product built by Muse Code on Meta's models.",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "snapshot": "tsx --env-file-if-exists=.env.local scripts/make-builder-snapshot.ts",
    "rebuild-all": "tsx --env-file-if-exists=.env.local scripts/rebuild-all.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "@vercel/sandbox": "3.9.0",
    "@vercel/sdk": "1.28.51",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "openai": "7.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workflow": "5.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
