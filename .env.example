# Meta Model API. Platform only: never sent to products, and reaches sandboxes only through the firewall rule.
MODEL_API_KEY=

# Models the platform uses
BRIEF_MODEL=muse-spark-1.3
JUDGE_MODEL=muse-spark-1.3
BUILD_MODEL=muse-spark-1.3
COMPLEX_BUILD_MODEL=muse-wonder-1.0

# Vercel REST API token, used to publish each product as its own project. Create one at
# https://vercel.com/account/settings/tokens with access to the team below.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Vercel Sandbox. On Vercel this authenticates with OIDC automatically.
# Locally, run `vercel env pull` to get VERCEL_OIDC_TOKEN (valid 12 hours).
VERCEL_OIDC_TOKEN=
# Printed by `npm run snapshot`. Without it, every build installs Muse Code, Playwright and ffmpeg from scratch.
BUILDER_SNAPSHOT_ID=

# Postgres (Neon through the Vercel Marketplace)
DATABASE_URL=

# Vercel Blob (a public store) for inspo, uploads, screenshots, demo videos and transcripts. Either credential works.
# A store connected the new way sets BLOB_STORE_ID (and BLOB_WEBHOOK_PUBLIC_KEY) and signs in with the deployment's
# OIDC token. One connected the old way sets BLOB_READ_WRITE_TOKEN, which wins when both are set. Product uploads
# through the gateway and training uploads still need BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Platform. PLATFORM_URL is the public origin products use to reach the gateway. On Vercel it falls back to the
# production URL when unset.
PLATFORM_URL=
GATEWAY_TOKEN_PEPPER=
# Signs the session cookie. Any long random string.
SESSION_SECRET=
# The code people type to sign in, with their email and a personal password. Share it with testers and judges.
PLATFORM_ACCESS_CODE=
# Comma-separated. Admins skip the daily cap and can run batch rebuilds and the kill switch.
ADMIN_EMAILS=
# Admin sign-in: an ADMIN_EMAILS address types this instead of PLATFORM_ACCESS_CODE. Never share it, and make it
# different from PLATFORM_ACCESS_CODE. Sign-in can't grant admin while it's unset (OPEN_ACCESS=admin is the one other way).
ADMIN_ACCESS_CODE=
# Vercel sends this as a bearer token to cron routes.
CRON_SECRET=
# Lets scripts/rebuild-all.ts start batch rebuilds as the first ADMIN_EMAILS user (who must have signed in once, or
# opened a preview once while it had OPEN_ACCESS=admin).
AUTOMATION_SECRET=
# Turns sign-in off for demos. A visitor with a real session keeps it; everyone else acts as a shared account.
# "admin": the first ADMIN_EMAILS account, with admin powers (the guest if ADMIN_EMAILS is empty). It applies only on
# Vercel previews, which deployment protection keeps to the team, and on localhost (`npm run dev` listens on localhost
# only). Anywhere else, Vercel production included, "admin" means sign-in stays on.
# "guest": one shared Builder account and its daily cap, upload tokens limited per IP, and no refinements. It applies
# wherever it's set, production included. Leave empty to require sign-in.
OPEN_ACCESS=
MAX_BUILDS_PER_USER_PER_DAY=3
MAX_FIX_ROUNDS=3
# Platform-wide kill switch: no new builds or gateway calls once today's Meta spend passes this.
DAILY_SPEND_CAP_USD=40
# Lambda Cloud API key, for admin-only Muse Glimmer fine-tuning on rented GPUs. Platform only: never sent to a
# sandbox or a product. Nothing launches a GPU on its own; leave empty to keep tuning off.
LAMBDA_API_KEY=
