# Meta Model API. Platform only: never sent to products, and reaches sandboxes only through the firewall rule.
MODEL_API_KEY=

# Models the platform uses
BRIEF_MODEL=muse-wonder-1.0
JUDGE_MODEL=muse-wonder-1.0
BUILD_MODEL=muse-wonder-1.0
COMPLEX_BUILD_MODEL=muse-wonder-1.0
# Test and example builds only: set to muse-spark-1.3-contributor to run the brief, build, judge and a build's own
# product test calls on it. Meta may train on that tier, so use made-up data. Ignored on production. On a local run,
# where products call Meta directly, it also goes into the product's .env.local, so metaClient (and so respondJson and
# the agent kit) makes the same swap. Builds get that only from a builder snapshot made after Oct 31.
# TEST_MODEL=muse-spark-1.3-contributor

# Vercel REST API token, used to publish each product as its own project. Create one at
# https://vercel.com/account/settings/tokens with access to the team below.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Vercel Sandbox. On Vercel this authenticates with OIDC automatically.
# Locally, run `vercel env pull` to get VERCEL_OIDC_TOKEN (valid 12 hours).
VERCEL_OIDC_TOKEN=
# Printed by `npm run snapshot`. Without it, every build installs Muse Code, Playwright and ffmpeg from scratch.
BUILDER_SNAPSHOT_ID=

# Postgres (Neon through the Vercel Marketplace)
DATABASE_URL=
# Vercel Preview only: the pooled connection string of the empty "preview" database on the Neon branch "preview"
# (README.md, Preview database). Previews never use DATABASE_URL, which is production's there. Without this a preview
# runs with no database and its build skips migrations. A value that points at production's database stops the build.
# Unused anywhere else.
# PREVIEW_DATABASE_URL=

# Vercel Blob (a public store) for inspo, uploads, screenshots, demo videos and transcripts. Either credential works.
# A store connected the new way sets BLOB_STORE_ID (and BLOB_WEBHOOK_PUBLIC_KEY) and signs in with the deployment's
# OIDC token. One connected the old way sets BLOB_READ_WRITE_TOKEN, which wins when both are set. Product uploads
# through the gateway and training uploads still need BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Platform. PLATFORM_URL is the public origin products use to reach the gateway. On Vercel it falls back to the
# production URL when unset.
PLATFORM_URL=
GATEWAY_TOKEN_PEPPER=
# Signs the session cookie. Any long random string.
SESSION_SECRET=
# The code people type to sign in, with their email and a personal password. Share it with testers and judges.
PLATFORM_ACCESS_CODE=
# Comma-separated. Admins skip the daily cap and can run batch rebuilds and the kill switch.
ADMIN_EMAILS=
# Admin sign-in: an ADMIN_EMAILS address types this instead of PLATFORM_ACCESS_CODE. Never share it, and make it
# different from PLATFORM_ACCESS_CODE. Sign-in can't grant admin while it's unset (OPEN_ACCESS=admin is the one other way).
ADMIN_ACCESS_CODE=
# Vercel sends this as a bearer token to cron routes.
CRON_SECRET=
# Lets scripts/rebuild-all.ts start batch rebuilds as the first ADMIN_EMAILS user (who must have signed in once, or
# opened a preview once while it had OPEN_ACCESS=admin).
AUTOMATION_SECRET=
# Turns sign-in off for demos. A visitor with a real session keeps it; everyone else acts as a shared account.
# "admin": the first ADMIN_EMAILS account, with admin powers (the guest if ADMIN_EMAILS is empty). It applies only on
# Vercel previews, which deployment protection keeps to the team, and on localhost (`npm run dev` listens on localhost
# only). Anywhere else, Vercel production included, "admin" means sign-in stays on.
# "guest": one shared Builder account and its daily cap, upload tokens limited per IP, and no refinements. It applies
# wherever it's set, production included. Leave empty to require sign-in.
OPEN_ACCESS=
MAX_BUILDS_PER_USER_PER_DAY=3
MAX_FIX_ROUNDS=3
# Platform-wide kill switch: no new builds or gateway calls once today's Meta spend passes this.
DAILY_SPEND_CAP_USD=40
# Lambda Cloud API key, for admin-only Muse Glimmer fine-tuning on rented GPUs. Platform only: never sent to a
# sandbox or a product. Nothing launches a GPU on its own; leave empty to keep tuning off.
LAMBDA_API_KEY=
# Hugging Face Hub, for publishing each judged Muse Glimmer adapter with its training data and cards (docs/TRAINING.md
# "Hugging Face"). HF_TOKEN needs write access to repos under HF_NAMESPACE (a user or an organization). Platform only:
# never logged, never sent to a GPU or a browser. Leave it empty to keep publishing off.
HF_TOKEN=
HF_NAMESPACE=
# A physical board's MCP tool server (muse-device/server.py), which /api/device calls for admins. The token opens the
# board's camera and microphone. Platform only: never logged, never sent to a browser. Leave empty to keep it off.
DEVICE_MCP_URL=
DEVICE_MCP_TOKEN=
# "1" (the default) makes the published repos public once they are verified. "0" keeps them private, and so does any
# value other than 1, true, yes or on.
HF_PUBLIC=1
# Only for tests that use a fake Hub. https only, or plain http on localhost.
HF_ENDPOINT=
# "1" lets admins make a judged, published adapter's local files: a glimmer-quantize job merges it, makes GGUF builds in
# three sizes, checks them and publishes them to their own Hub repo (docs/TRAINING.md "Local files"). About $2.50 of GPU
# a run. Off when empty.
QUANT_ENABLED=

# Gadgets as a build option (docs/GADGETS.md). Off unless GADGETS_ENABLED is 1: turn it on once the builder snapshot
# has the gadget helper and skill.
GADGETS_ENABLED=

# Flash drive orders (docs/VIBE_TUNING.md, Feature 6). Off unless DRIVE_ENABLED is 1. An order saves the model, the
# build and the shipping address. It is paid by card on Stripe when STRIPE_* and DRIVE_PRICE_CENTS below are set, and
# otherwise the owner emails an invoice. The owner moves orders along at /fine-tuning/orders, and
# scripts/drive-bench.ts flashes and checks the stick.
DRIVE_ENABLED=
# Shown as the price, such as "$59 with US shipping, invoiced by email". Empty: "We'll email you a quote before anything
# is charged."
DRIVE_PRICE_TEXT=
# A Slack or Discord webhook that gets one line per new request, never the buyer's name, email or address. Optional.
DRIVE_NOTIFY_URL=
# Where buyers write about an order: shown on the request form, the order pages and the drive, and in "Stuck?" on the
# run-locally page. Empty: the pages say to reply to the invoice's email.
DRIVE_CONTACT_EMAIL=
# Requests per client (IP or browser) and from everyone, per rolling 24 hours.
DRIVE_CLIENT_REQUESTS=3
DRIVE_DAILY_REQUESTS=20
# The version of the terms the form shows (lib/drive/terms.ts). Change it with their text. Empty: the version in that file.
DRIVE_TERMS_VERSION=
# Paying by card on Stripe Checkout (docs/VIBE_TUNING.md, Feature 6, "Paying by card"). With all three set (and
# DRIVE_ENABLED), new orders are paid by card when they're placed; otherwise they're invoiced by email as above. Point a
# Stripe webhook at <site>/api/drive/stripe for checkout.session.completed and checkout.session.async_payment_succeeded,
# and put its signing secret here. A restricted key needs Checkout Sessions and Refunds write access.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The card price in US cents, with US shipping included: 5900 is $59.
DRIVE_PRICE_CENTS=
# A live Stripe key (sk_live_) charges real cards only when this is 1, after the counsel, tax and insurance review.
DRIVE_LIVE_SALES=
# The SHA-256 of the bench script's token: `npx tsx scripts/drive-bench.ts token` prints a new token and its hash, and
# needs no platform secret. The token stays on the bench Mac as DRIVE_BENCH_TOKEN; only the hash goes here.
DRIVE_BENCH_TOKEN_HASH=

# Live docs demos (/docs, docs/DOCS_MIRROR.md): the key the docs proxy calls Meta with, server only. Empty: MODEL_API_KEY locally, demos paused on Vercel.
DOCS_MODEL_API_KEY=
# "off" pauses every live docs call (503 docs_paused); the docs pages still work.
DOCS_LIVE=
# What all docs visitors together may spend per UTC day, and what one client IP may. DAILY_SPEND_CAP_USD still applies.
DOCS_DAILY_SPEND_CAP_USD=25
DOCS_IP_DAILY_USD=2
# Live docs calls per client IP: a minute, a UTC day, and at once. Raise them for a local test server.
DOCS_IP_REQUESTS_PER_MINUTE=20
DOCS_IP_REQUESTS_PER_DAY=400
DOCS_IP_IN_FLIGHT=4

# The muse-app look for new products (docs/BRAND.md). "1" applies template/targets/muse-app at provision and points the
# build, fix and change prompts and the judge at its muse-app-ui skill. Empty keeps meta-ui and every prompt as it was.
# Make a new builder snapshot first (npm run snapshot): the live site can't add the overlay to an older one.
MUSE_APP_LOOK=

# Where a product runs (docs/NATIVE.md). All off when empty: the brief schema, the prompts and the composer stay exactly
# as they are, and no native run starts. A comma list of phone and desktop. vr, glasses and agent have switches below.
NATIVE_TARGETS=
# "1" lets the brief writer pick a VR app or Meta glasses. Turn them on only after the builder snapshot has their overlays.
VR_ENABLED=
GLASSES_ENABLED=
# "1" also checks a shipped glasses product on the iPhone Simulator with Meta's mock glasses. It never blocks shipping.
GLASSES_NATIVE_CHECKS=

# The native lane (docs/NATIVE.md). "1" checks products on the AWS lab boxes, and lets admin builds use AWS Device Farm.
NATIVE_LAB=
NATIVE_DEVICE_FARM=
# Caps on AWS spend, in USD: everything, an alert on the admin page, Device Farm and Windows. AWS Budgets is the backstop.
NATIVE_SPEND_CAP_USD=150
NATIVE_SPEND_ALERT_USD=120
NATIVE_DEVICE_FARM_CAP_USD=40
NATIVE_WINDOWS_CAP_USD=15
# What the boxes cost per hour, in USD. The Mac host's whole span, from allocation to release (ISO dates), is a fixed cost.
NATIVE_MAC_HOURLY_USD=0.65
NATIVE_WINDOWS_HOURLY_USD=0.111
NATIVE_MAC_ALLOCATED_AT=
NATIVE_MAC_RELEASE_AT=
NATIVE_MAC_INSTANCE_ID=
NATIVE_WINDOWS_INSTANCE_ID=
# The role the platform reaches AWS through, with its Vercel OIDC identity. There are no long-lived AWS keys.
AWS_ROLE_ARN=
# The lab boxes' region. Device Farm is always in us-west-2. Not AWS_REGION: on Vercel that can be the function's region.
NATIVE_AWS_REGION=us-east-1
# The Device Farm project, and a comma list of the Android devices to run on.
DEVICE_FARM_PROJECT_ARN=
DEVICE_FARM_ANDROID_DEVICE_ARNS=
# The packager sandbox's snapshot (docs/NATIVE_PACKAGER.md).
PACKAGER_SNAPSHOT_ID=
# The Android signing key: base64 of a PEM file with the private key and its certificate, and its passphrase if it has one.
# Platform only: it never enters the packager sandbox. Without it, APKs keep the public debug key.
NATIVE_APK_KEYSTORE_B64=
NATIVE_APK_KEYSTORE_PASSWORD=

# Agents with tools (docs/AGENT_TOOLS.md). "1" lets the brief writer pick the agent target. Turn it on only after the
# builder snapshot has the agent kit.
AGENTS_ENABLED=
# Platform only: never in a sandbox, a product or a browser. Needs Instant Toolkits on and a prepaid balance.
COMPOSIO_API_KEY=
# "1" gives a product's owner Gmail, Calendar and Slack on their own accounts. Composio keeps tool payloads up to a year
# without its paid zero data retention, so settle that before these reach anyone but owners.
COMPOSIO_PERSONAL_ENABLED=
# What all tools together may spend per UTC day, in USD. Composio has no cap of its own, so this is the only one. 0 pauses them.
TOOLS_DAILY_SPEND_CAP_USD=10
# Tool calls per UTC day across every product. Keeps the platform under Composio's 100k calls a month.
TOOLS_DAILY_CALLS=3000
# Optional. Empty: tool signing keys are derived from GATEWAY_TOKEN_PEPPER.
TOOLS_SIGNING_SECRET=
# Products' share of the team's Muse Wonder tokens per minute, so agents can't starve builds.
GATEWAY_WONDER_TPM=1500000

# What every product comes with (docs/PRODUCT_OUTPUTS.md). "1" offers a CLI, a skill file and a Claude plugin on the product
# page, with setup steps for MCP, the Muse app and ChatGPT.
PRODUCT_OUTPUTS=
# "1" runs each output against the live product after it ships and records a video of each. It starts after the build is
# final, so it can't fail or delay Live. Needs PRODUCT_OUTPUTS.
PROVE_IT=
# What one Prove it run may spend at Meta, in USD, charged to its build.
PROVE_IT_CAP_USD=1.5
# "1" re-checks live products each night on Muse Spark Contributor. Needs PROVE_IT.
PROVE_NIGHTLY=
PROVE_NIGHTLY_PRODUCTS=5
# "1" is for a local run only: the stage writes the CLI, skill and plugin into its copy, for a deployed site without those routes.
PROVE_PUT_FILES=

# ---------- Wave 3, unit 1: trust (docs/CAPABILITIES.md) ----------
# "1": saving data, connecting accounts, jobs, running code and hardware need a signed-in builder. Guests get the rest.
TRUST_SIGNED_IN_CAPS=
# What one signed-in builder's products may spend together per UTC day, in USD, every source counted. 0 pauses them.
TRUST_BUILDER_DAILY_USD=5
# "1": builders confirm they're 18 or older at sign-in (once per terms version), and new products get a one-tap age gate.
TRUST_AGE_GATE=
# "1": /privacy and /terms on the platform, and privacy and terms pages in new products. The text is a draft for review.
TRUST_LEGAL_PAGES=
# "1": requests from the territories below are refused, on the platform and in new products (Vercel's country header).
TRUST_GEO_BLOCK=
# ISO country codes and region codes (UA-43), or "meta" for the list in Meta's Geographic Use Policy (lib/trust/geo.ts).
# Empty blocks nothing. The platform reads it at build time, so a change needs a redeploy.
TRUST_GEO_COUNTRIES=
# "1": a Report link on every new product, /admin/reports, takedown and ban.
TRUST_REPORTS=
# "1": live products' calls to the retired Muse Spark 1.3 run on Muse Wonder, not Contributor. About 40 to 100 times the
# price per call, so their daily budgets cover fewer runs. Owner decision before production.
TRUST_SPARK_TO_WONDER=
# The most one product deployment's files may add up to, in MB. 100 is Vercel's Hobby number; a Pro team can use up to
# 1000. A product over it, or with one file over 100 MB, fails its deploy naming the files. Nothing is left out.
TRUST_DEPLOY_TOTAL_MB=100

# ---------- Wave 3, unit 2: engine (docs/CAPABILITIES.md) ----------
# "1": a first Muse Code round that hits its time cap goes on to the checks and fix rounds instead of failing the build.
ENGINE_CHECK_ON_TIMEOUT=
# "1": round time grows with the brief (5 more minutes for a complex brief, a big one and each platform service).
ENGINE_ROUND_SCALING=
# The longest a scaled first round may run, in minutes (25 to 90).
ENGINE_ROUND_MAX_MINUTES=45
# "1": the brief writer may split a big brief into 2 or 3 milestones, each built in its own chained round.
ENGINE_MILESTONES=
# "1": after deploy, the live link and its routes are loaded (no model call) before a product is marked live.
ENGINE_LIVE_SMOKE=
# "1": the brief writer says when a product's main claim needs real code (a parser, a solver), not a model call.
ENGINE_EXACT_LOGIC=
# "1": a model call the token's budget can't cover at its max_output_tokens runs with a lower one instead of a refusal.
ENGINE_FIT_OUTPUT=

# ---------- Wave 3, unit 8: media (docs/CAPABILITIES.md) ----------
# "1": the brief writer may give a product media made in its page (the parts below), and the gateway serves the vetted
# large files at /assets. Does nothing until the media cap is marked ready (lib/caps/ids.ts).
MEDIA_ENABLED=
# "1": text read aloud by an open model in the page (SpeechT5, MIT), with the browser's voice as the fallback. Needs the
# files mirrored first: npx tsx --env-file=.env.local scripts/caps/mirror-assets.ts --apply
MEDIA_SPEECH=
# "1": videos made from pictures in the page (WebCodecs, MP4).
MEDIA_VIDEO=
# "1": music as MIDI files, played with built-in tones, and hummed tunes turned into notes.
MEDIA_MUSIC=
# "1": SAM 3.1 on overlapping tiles for photos with more than 16 matches (up to 16 calls a photo), and long clips in chunks.
MEDIA_SAM_TILING=

# ---------- Wave 3, unit 10: runtime (docs/CAPABILITIES.md) ----------
# "1": the brief writer may give a product small Python functions (numpy, pandas and the like), with PyPI open to its build
# for downloads only. Does nothing until the runtime cap is marked ready (lib/caps/ids.ts).
RUNTIME_ENABLED=
# "1": live products also offer a VS Code extension and a GitHub Action, and their owners a self-host kit. Never published.
RUNTIME_OUTPUTS=

# ---------- Wave 3, unit 12: drive export (docs/CAPABILITIES.md, docs/DRIVE_EXPORT.md) ----------
# "1" shows the Flash drive card on /device: a fine-tuned model from the board or the lab goes onto a USB stick plugged into
# the board. Admins only. Needs DEVICE_MCP_URL and DEVICE_MCP_TOKEN, setup-drive.sh on the board, and an uploaded drive kit.
DRIVE_EXPORT_ENABLED=
# "1" lets a product's owner export their own tuned model from the product. Waits for the board registry (unit 13): keep off.
DRIVE_EXPORT_PRODUCTS=

# ---------- Wave 3, unit 14: native (docs/CAPABILITIES.md) ----------
# "1": the brief writer may give a product a Chrome extension (Manifest V3) that calls its own actions, packaged from the
# live link after each deploy and offered on the product's page with Load unpacked steps. Never published to a store.
# Does nothing until the extension cap is marked ready (lib/caps/ids.ts).
NATIVE_EXTENSION=
# "1": the brief writer may build a game on Phaser 4 (2D) or Babylon.js 9 (3D). Does nothing until the games cap is ready.
NATIVE_GAME_ENGINES=
