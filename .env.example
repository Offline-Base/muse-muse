# Copy to .env. Never commit .env.
BASE_DEVICE=laptop            # laptop or jetson
BASE_HOME=~/.base

# Every model on this device, with LFM3-VL-2B answering each step and your policy deciding what
# is shared. Needed for the FERPA, COPPA and HIPAA toggles. See docs/COMPLIANCE_PLAN.md.
# DEVICE_ONLY=1

# Where Glimmer runs. openrouter is development only and refuses folders without a .synthetic marker.
GLIMMER_BACKEND=openrouter    # openrouter or llama_server
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
GLIMMER_MODEL=meta/muse-glimmer-30b
# llama_server mode:
# ANSWER_URL=http://127.0.0.1:8081/v1
# ROUTER_URL=http://127.0.0.1:8082/v1
# LLAMA_API_KEY=   (empty: read from BASE_HOME/llama_api_key, which scripts/start.sh makes)
# The router's model call (Glimmer; LFM runs with thinking off and ignores the level):
# ROUTER_REASONING=low        # low, medium, high or xhigh
# ROUTER_MAX_TOKENS=1500      # reasoning counts against this; 64 to 32768

# The checks and search. glimmer: the answer model above. lfm: Liquid's LFM3-VL-2B on this device
# (scripts/start_checker.sh, llama.cpp b11960+), for the name check, the request-topic check,
# search passage picking and reading scanned images. Always local, so it reads any folder.
CHECKER_BACKEND=glimmer       # glimmer or lfm
# CHECKER_URL=http://127.0.0.1:8083/v1
# CHECKER_MODEL=lfm3-vl-2b
# CHECKER_SERVER_BIN=         # llama-server from llama.cpp b11960 or newer; default: LLAMA_SERVER_BIN
# CHECKER_GGUF=               # default models/LFM3-VL-2B-Q4_K_M.gguf
# CHECKER_MMPROJ=             # default models/mmproj-LFM3-VL-2B-Q8_0.gguf
# CHECKER_CTX=16384
# RAG_CANDIDATES=20           # keyword-search candidates the checker picks search passages from

# Meta's SAM 3.1 region finder (sidecars/sam/, scripts/start_sam.sh, 127.0.0.1:8085): finds faces,
# signatures, ID cards and barcodes in page images. Off unless SAM_ENABLED=1. Needs its weights and
# its own environment first (sidecars/sam/README.md); start_sam.sh never downloads or installs.
# With SAM_ENABLED=1 scripts/start.sh starts it too, and the device covers what it finds before the
# local model reads a page; while it is not running, page images are not read at all.
# SAM_ENABLED=0
# SAM_URL=http://127.0.0.1:8085
# SAM_MODEL_DIR=              # default models/sam3.1-mlx
# SAM_MODEL_ID=               # default mlx-community/sam3.1-bf16; mlx-community/sam3-8bit is SAM 3

# Muse Spark through the Meta Model API: eval harness and synthetic data only.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3

# Connector relay (Cloudflare Worker in relay/).
RELAY_URL=
# RELAY_PROXY=system          # system (default): the system or environment proxy; direct: bypass every proxy
# CONTACTS_PATH=              # save_on_device's contact sheet; default WORKSPACE_ROOT/records/parent_contacts.md

# llama_server mode, read by scripts/start.sh when it starts Glimmer on this device:
# LLAMA_SERVER_BIN=           # path to llama-server (llama.cpp b10353 or newer); default: llama-server on PATH
# GLIMMER_GGUF=               # path to the Glimmer .gguf (Q4_K_M on a laptop, i1-IQ1_S on a Jetson)
# ANSWER_CTX=16384            # context size for the answer model on port 8081
# ROUTER_CTX=8192             # context size for the router on port 8082
# For Glimmer's servers only (scripts/plug_in_model.py sets these):
# GLIMMER_DRAFT_GGUF=         # a DFlash drafter .gguf for speculative decoding; empty: none
# GLIMMER_DRAFT_N=15          # tokens drafted per step (--spec-draft-n-max)
# GLIMMER_FA=auto             # flash attention: on, off or auto
# GLIMMER_REASONING_BUDGET=-1 # thinking tokens: -1 unrestricted, 0 none, or a number

# Jetson only: the approval page may listen on the home network.
# APPROVAL_HOST=
# HEAVY_QUEUE=1               # 1 on a Jetson: grading steps may go to the laptop's dial-out worker
# Laptop only: the Jetson's approval page, for the dial-out heavy-step worker.
# JETSON_URL=                 # for example http://<jetson address>:8787
# HEAVY_TOKEN=                # worker token; print it on the Jetson with: python -m base.heavy.routes

DREAMING_BACKEND=prompt       # prompt or lora
# LIGHT_SERIAL=/dev/ttyACM0

# Tags change every day, so a tag Muse kept cannot name anyone for long. An old tag still works
# for TAG_GRACE_HOURS after its day ends, however often it is sent. off keeps one tag per person.
# TAG_ROTATION=daily          # daily or off
# TAG_GRACE_HOURS=36

# Router changes that ask less often, measured in eval/reports/dev/loosen/README.md. A comma list of
# lists, result_words and class_of, or all or none.
# ROUTER_LOOSEN=lists,result_words

# TLS for the approval port on a Jetson on your home network (deploy/jetson/install.sh makes a
# self-signed pair). The laptop worker pins the certificate with --ca-cert.
# APPROVAL_TLS_CERT=
# APPROVAL_TLS_KEY=
