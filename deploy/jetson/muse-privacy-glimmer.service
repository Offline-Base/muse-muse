# Muse Glimmer i1-IQ1_S on llama-server, loopback only. Installed by deploy/jetson/install.sh.
[Unit]
Description=Muse Privacy Glimmer model (llama-server on 127.0.0.1:8081)
After=network.target
AssertPathExists=/opt/muse-privacy/models/Muse-Glimmer-30B.i1-IQ1_S.gguf
AssertPathExists=/opt/muse-privacy/llama.cpp/build/bin/llama-server

[Service]
Type=simple
User=muse-privacy
Group=muse-privacy
# glimmer-env.sh writes LORA_ARGS to /var/lib/muse-privacy/glimmer.env. When
# /var/lib/muse-privacy/adapters/router.gguf exists it holds
# "--lora /var/lib/muse-privacy/adapters/router.gguf --lora-init-without-apply", so the router
# adapter is loaded but off until a request (or adapter_sync.sh) turns it on; otherwise it is empty.
ExecStartPre=/opt/muse-privacy/bin/glimmer-env.sh
EnvironmentFile=-/var/lib/muse-privacy/glimmer.env
ExecStart=/opt/muse-privacy/llama.cpp/build/bin/llama-server --model /opt/muse-privacy/models/Muse-Glimmer-30B.i1-IQ1_S.gguf --alias glimmer --host 127.0.0.1 --port 8081 -c 4096 -np 1 -ngl 99 --no-mmproj --jinja $LORA_ARGS
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

# Hardening. No PrivateDevices: llama-server needs the Jetson's GPU device nodes (the user is in
# the video group). No MemoryMax: the GPU shares the board's 8 GB with the CPU, and a cgroup cap
# that also counted GPU buffers would kill the model mid-load.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/muse-privacy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
